# Spotify OAuth app credentials
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret
REDIRECT_URI=http://127.0.0.1:8888/callback

# Obtained by running: npm run auth (scripts/auth.ts)
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# Shared secret for MCP endpoint — use a long random string
MCP_SHARED_SECRET=change_me_to_a_long_random_secret

# Server port (default 3000)
PORT=3000

# set_ai_cover generates covers for free via Pollinations (no key needed).
# Optionally set an OpenAI key to use gpt-image-1 instead (paid, higher quality).
# OPENAI_API_KEY=sk-...
